# REMOCO — environment variables (template)
#
# This project has no dependency manager, so it does not parse .env files.
# These names are read by includes/config.php via PHP's getenv(), which means they must
# be set as REAL environment variables to take effect, for example:
#
#   Apache httpd.conf / .htaccess :  SetEnv REMOCO_DB_USER remoco_app
#   Docker                        :  docker run --env-file .env ...
#   Windows (PowerShell)          :  $env:REMOCO_DB_USER = "remoco_app"
#
# If you are running locally under XAMPP, you do not need any of this — just
# copy includes/config.example.php to includes/config.php and edit it directly.
#
# Environment variables always take precedence over the literals in config.php.

# --- Timezone --------------------------------------------------------------
# Must match your MySQL server's timezone. Check it with:
#   SELECT @@system_time_zone, @@session.time_zone;
REMOCO_TIMEZONE=UTC

# --- Database (MySQL) ------------------------------------------------------
REMOCO_DB_HOST=localhost
REMOCO_DB_USER=root
REMOCO_DB_PASSWORD=
REMOCO_DB_NAME=remoco_db

# --- Firebase Realtime Database (in-app chat) ------------------------------
# Found in Firebase Console > Project settings > Your apps > SDK setup.
# The web API key is not a secret; access is governed by Security Rules.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Default (global) Realtime Database endpoint — used by the dashboards.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Regional Realtime Database endpoint — used by the chat pages.
FIREBASE_DATABASE_URL_REGIONAL=https://your-project-default-rtdb.your-region.firebasedatabase.app

# --- Agora RTC (video calls) ----------------------------------------------
# Found in Agora Console > Project Management.
# AGORA_TOKEN is a temporary development token and expires (24h by default).
AGORA_APP_ID=your-agora-app-id
AGORA_TOKEN=your-agora-temp-token
