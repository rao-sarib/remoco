# ---------------------------------------------------------------------------
# Secrets & local configuration  —  NEVER COMMIT THESE
# ---------------------------------------------------------------------------
includes/config.php
includes/api_config.php
.env
.env.local
*.pem
*.key
*-service-account*.json
serviceAccountKey.json

# ---------------------------------------------------------------------------
# Runtime user uploads
# ---------------------------------------------------------------------------
# The directory is tracked (via .gitkeep) but its contents are not: uploaded
# files are user data and may contain anything.
public/uploads/*
!public/uploads/.gitkeep

# ---------------------------------------------------------------------------
# Local-only captures
# ---------------------------------------------------------------------------
# Screenshots kept for local reference and not part of the published catalogue.
docs/screenshots/*.local.png

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
nbproject/
.project
.buildpath
.settings/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
desktop.ini

# ---------------------------------------------------------------------------
# Logs, dumps & temp files
# ---------------------------------------------------------------------------
*.log
logs/
error_log
php_errorlog
*.sql.gz
*.dump
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~
tmp/
temp/
.cache/

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/vendor/
node_modules/

# Unreferenced 1.1 MB vendored copy of the Agora SDK. The chat pages load the
# SDK from Agora's CDN, so nothing points at this file — it is kept on disk as a
# local fallback but excluded from the repository to avoid shipping dead weight.
AgoraRTC_N-4.19.0.js

# ---------------------------------------------------------------------------
# Office lock files
# ---------------------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.pptx

# API runtime uploads (mirror of public/uploads policy)
public/api/uploads/*
!public/api/uploads/.gitkeep
